bazel_dep(name = "rules_img", version = "0.3.19")
bazel_dep(name = "rules_img_tool", version = "0.3.19")
bazel_dep(name = "rules_distroless", version = "0.6.2")
bazel_dep(name = "tar.bzl", version = "0.10.8")
bazel_dep(name = "grype.bzl", version = "0.1.0")
bazel_dep(name = "cosign.bzl", version = "0.0.0")
bazel_dep(name = "container_structure_test", version = "1.22.1")

local_path_override(
    module_name = "cosign.bzl",
    path = "bazel/modules/cosign.bzl",
)

single_version_override(
    module_name = "rules_distroless",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_distroless_version_sort.patch",
        "//bazel/patches:rules_distroless_virtual_provides.patch",
        "//bazel/patches:rules_distroless_package_metadata.patch",
    ],
    version = "0.6.2",
)

register_toolchains(
    "//bazel/toolchains/cosign",
    "//bazel/toolchains/grype",
)

git_override(
    module_name = "grype.bzl",
    commit = "3faf01f19537ba685f9deb9c12b3742b1815c583",
    remote = "https://github.com/arkeros/grype.bzl.git",
)

grype_db = use_extension("@grype.bzl//grype:extensions.bzl", "grype_database", dev_dependency = True)
grype_db.database(
    name = "grype_database",
    sha256 = "3574269f1e15cc771bd8ea11a31f2e198c5e4cc546ae7d3187919c8f4822cb7a",
    url = "https://grype.anchore.io/databases/v6/vulnerability-db_v6.1.9_2026-09-03T00:34:04Z_1788417055.tar.zst",
)
use_repo(grype_db, "grype_database")

# The nginx base the games' frontend images are built on: Chainguard's, from
# Wolfi. Every package in it is `pkg:apk/wolfi/...`, which grype routes to
# Wolfi's secdb, and Chainguard rebuilds daily — so what this buys over
# assembling a base in-house is that a clean scan means clean, with no
# cross-vendor false positives to justify.
#
# Pinned by digest. `latest` is the only tag Chainguard publishes for free, so
# a bump takes whichever nginx they ship that day; the tag is carried for
# readability only. Bump with:
#
#   crane digest cgr.dev/chainguard/nginx:latest
#   ./oci/base_images/refresh.sh chainguard_nginx cgr.dev/chainguard/nginx@sha256:<digest>
images = use_extension("@rules_img//img:extensions.bzl", "images")
images.pull(
    name = "chainguard_nginx",
    digest = "sha256:2015f7fa3b514c1bb8de63ed0ebe769295e6d15c5a401fcafbbe555760d42e57",
    # Not the default `shallow`: the app images produce an `oci_layout`, and a
    # layout with only metadata and no blobs is not a layout. `lazy` fetches
    # each blob the first time something actually needs it.
    layer_handling = "lazy",
    registry = "cgr.dev",
    repository = "chainguard/nginx",
    tag = "latest",
)

# The hub repo, not the image repo directly: rules_img names generated repos
# after the digest, and `image("chainguard_nginx")` from the hub resolves the
# friendly name to it. `bazel mod tidy` rewrites this line, so keep it as-is.
use_repo(images, "rules_img_images.bzl")
