"""Shared helpers for senku aspect-cli tasks."""

load("./runnable.axl", "runnable")

# The deploy DAG is a query, not a list.
#
# Every node publishes what it is and what it waits for as tags (see
# `deploy_tags` in the terraform.bzl module), so joining the graph *is*
# declaring the target. There is nothing here to keep in sync: a new root
# deploys by default, and an example opts out with `deploy = False` at its own
# call site.
#
# Nodes are operations, not roots. A `tf_root` is one kind; a plain runnable —
# senku pushes container images — is another. That distinction is what lets an
# edge point at the thing that genuinely has the dependency: an app's image
# push needs the registry to exist, while the app's Terraform does not.
#
# This used to be a hand-maintained ordered list. It drifted — an app was
# added without an entry, so it built, merged and passed CI while never
# deploying, and its load balancer backend served a silent 404 pointing at a
# Cloud Run service nothing would ever create. See
# docs/adr/0008-derived-terraform-deploy-set.md.

# Mirrors the tag vocabulary emitted by the terraform.bzl module.
_TAG_DEPLOY = "tf-deploy"

_TAG_BOOTSTRAP = "tf-bootstrap"

_TAG_KIND_ROOT = "tf-kind=root"

_TAG_AFTER = "tf-after="

def _query(ctx, expr):
    """Labels matching a `bazel query` expression, or None if it failed.

    Shells out rather than using `ctx.bazel`, which exposes `build` but no
    query verb — the same reason `runnable.axl` spawns `bazel cquery`
    directly to resolve entrypoints.
    """
    result = ctx.std.process.command("bazel") \
        .args([
            "query",
            expr,
            "--output=label",
            "--ui_event_filters=-info",
            "--noshow_progress",
        ]) \
        .stdout("piped") \
        .stderr("piped") \
        .spawn() \
        .wait_with_output()
    if result.status.code != 0:
        ctx.std.io.stderr.write(result.stderr)
        return None
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]

def _topo_sort(ctx, nodes, predecessors):
    """Kahn's algorithm. None (after reporting a cycle) if one exists.

    Ready nodes are taken in sorted order, so a graph with slack always
    linearises the same way — an ordering that shifts between runs would make
    a deploy log impossible to compare against the previous one.
    """
    waiting = {n: [p for p in predecessors[n] if p in nodes] for n in nodes}
    ordered = []

    for _ in range(len(nodes)):
        ready = sorted([n for n in waiting if not waiting[n]])
        if not ready:
            break
        ordered.extend(ready)

        # Rebuilt rather than mutated: Starlark refuses to change a dict while
        # something is iterating it, and both the drop and the edge-clearing
        # would be doing exactly that.
        waiting = {
            n: [p for p in ps if p not in ready]
            for n, ps in waiting.items()
            if n not in ready
        }

    if waiting:
        ctx.std.io.stderr.write(
            "ERROR: cycle in the deploy graph among: {}\n".format(
                ", ".join(sorted(waiting)),
            ),
        )
        return None
    return ordered

def deploy_nodes(ctx):
    """Every deploy node in dependency order. None if discovery failed.

    Returns structs of `label` and `is_root`: a root is driven through its
    `.apply` runnable, anything else is simply run.

    Bootstrap roots are dropped under `$CI` and the skip is announced on
    stderr, so a CI log explains its own gaps rather than leaving a reader to
    wonder why a node is missing. Their edges go with them — nothing else
    depends on a bootstrap root, and `_topo_sort` ignores predecessors that
    aren't in the set.
    """
    err = ctx.std.io.stderr

    nodes = _query(ctx, 'attr(tags, "{}", //...)'.format(_TAG_DEPLOY))
    if nodes == None:
        return None
    if not nodes:
        err.write("ERROR: no deploy nodes found; is the tag vocabulary wired up?\n")
        return None

    if is_ci(ctx):
        bootstrap = _query(ctx, 'attr(tags, "{}", //...)'.format(_TAG_BOOTSTRAP))
        if bootstrap == None:
            return None
        for node in sorted(bootstrap):
            err.write("skipping {} (bootstrap-tier; apply locally only)\n".format(node))
        nodes = [n for n in nodes if n not in bootstrap]

    # Scope every follow-up query to the set we already have, so each is a
    # lookup over a dozen known targets rather than another sweep of `//...`.
    scope = "set({})".format(" ".join(nodes))

    roots = _query(ctx, 'attr(tags, "{}", {})'.format(_TAG_KIND_ROOT, scope))
    if roots == None:
        return None

    # Edges are stored on the dependent ("I come after X"), so ask, for each
    # node, who declared themselves after it. One query per node, and no tag
    # parsing — `--output=label` answers directly.
    predecessors = {n: [] for n in nodes}
    for node in nodes:
        dependents = _query(ctx, 'attr(tags, "{}{}", {})'.format(_TAG_AFTER, node, scope))
        if dependents == None:
            return None
        for dependent in dependents:
            predecessors[dependent].append(node)

    ordered = _topo_sort(ctx, nodes, predecessors)
    if ordered == None:
        return None
    return [struct(label = n, is_root = n in roots) for n in ordered]

def is_ci(ctx) -> bool:
    return ctx.std.env.var("CI") != None

def normalize_root(target) -> str:
    """Accept either `//path` or `//path:terraform`; default to `:terraform`.

    The convention for in-repo tf_root targets is `<root>:terraform`. Letting
    callers omit the `:terraform` makes `aspect apply //oci/cmd/registry`
    work as a sibling of the more explicit
    `aspect apply //oci/cmd/registry:terraform`.
    """
    if ":" in target:
        return target
    return target + ":terraform"

def select_nodes(ctx, requested):
    """Resolve the nodes to act on, in dependency order. None if that failed.

    If the caller passed explicit targets, honor them verbatim and treat each
    as a root — the bootstrap filter is bypassed, so an explicit `aspect plan
    //infra/cloud/gcp/ci:terraform` still works in CI for the rare case a
    maintainer wants it, and a `deploy = False` example can still be planned
    by name.

    With no targets, discover the graph. Returns None (not an empty list) when
    a query fails, so callers can tell "nothing to do" apart from "we don't
    know what to do" and fail instead of quietly succeeding.
    """
    if len(requested) > 0:
        return [struct(label = normalize_root(t), is_root = True) for t in requested]

    return deploy_nodes(ctx)

def select_roots(ctx, requested):
    """`select_nodes`, narrowed to Terraform roots.

    For `aspect plan`, which has nothing to say about a node that isn't a
    Terraform root: there is no plan for pushing an image. Apply walks the
    whole graph; plan walks the part of it that can be planned.
    """
    nodes = select_nodes(ctx, requested)
    if nodes == None:
        return None
    return [n.label for n in nodes if n.is_root]

def build_runnable(ctx, target, build_flags = []):
    """Build `target` and resolve its runtime entrypoint, so the binary
    can be spawned directly (with the runfiles env wired up by
    `runnable`) instead of round-tripping through `bazel run`.

    Returns `(entrypoint, runnable)` on success, or `(None, None)` on
    build failure. Callers reuse the returned `runnable` to spawn the
    same binary multiple times without rebuilding.

    Stays on the workspace default `--nobuild_runfile_links`: spawned
    binaries must use a runfiles library (Bazel's bash/Go/etc.) so they
    resolve via the manifest. Forcing the symlink tree here would flip
    the option vs. bare `bazel build` and discard the analysis cache on
    every alternation.

    Forces `--remote_download_outputs=toplevel` to override the CI-wide
    `minimal` default: when a pure cache-hit build produces no local
    actions (no processwrapper-sandbox, etc.), nothing materializes the
    binary or its runfiles on disk and the subsequent spawn fails with
    ENOENT. `toplevel` downloads the executable and its runfiles tree,
    which is exactly what we're about to spawn. This is an execution
    flag, so it doesn't invalidate the analysis cache across alternations
    with bare `bazel build`.
    """
    out = ctx.std.io.stdout
    err = ctx.std.io.stderr

    flags = [
        "--isatty=" + str(int(out.is_tty)),
        "--remote_download_outputs=toplevel",
    ]
    flags.extend(build_flags)

    out.write("==> bazel build {}\n".format(target))
    # No `build_events = True`: the returned Build no longer exposes the
    # BEP stream (see runnable.axl), and asking for events nothing reads
    # just leaves the build blocked. Bazel inherits our stdio, so its
    # progress reaches the terminal directly instead of being relayed
    # through `progress` events.
    if not ctx.bazel.build(target, flags = flags).wait().success:
        err.write("ERROR: build failed for {}\n".format(target))
        return None, None

    # Only the caller's flags go to the entrypoint lookup: `--isatty` and
    # `--remote_download_outputs` shape this invocation, not the output
    # tree, so cquery doesn't need (or necessarily accept) them.
    r = runnable(ctx, build_flags)

    entrypoint = r.determine_entrypoint(target)
    if entrypoint == None:
        err.write("ERROR: could not determine entrypoint for {}\n".format(target))
        return None, None

    return entrypoint, r

def build_and_run(ctx, target, args = [], env = {}, build_flags = []):
    """Build `target`, then spawn it once with `args` + `env` and wait.

    Returns the exit struct (`.success`, `.code`) on success, or `None`
    if the build itself failed.
    """
    entrypoint, r = build_runnable(ctx, target, build_flags)
    if entrypoint == None:
        return None
    return r.spawn(entrypoint, args, env).wait()
