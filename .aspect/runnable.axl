"""Runfiles-aware spawn helper for Bazel-built binaries.

Originally vendored from https://github.com/aspect-extensions/run via
astrograde's copy. Local deviations:

- `command(entrypoint, args, env)` returns the un-spawned
  `std.process.Command` so callers can chain `.stdout("piped")` etc.
  before `.spawn()`. This is what lets `aspect plan` capture each
  root's plan output for the PR comment without going through
  `bash | tee`.
- `_command` no longer sets `current_dir` to the runfiles tree. Under
  the workspace default `--nobuild_runfile_links` that directory isn't
  materialized, so the chdir would fail. Spawned binaries should
  resolve files via a Bazel runfiles library (RUNFILES_DIR /
  RUNFILES_MANIFEST_FILE are still exported here) rather than via cwd.
  Inherits the caller's cwd instead, which matches `BUILD_WORKING_DIRECTORY`.
- The entrypoint is resolved with `bazel cquery --output=files` instead
  of by consuming the Build Event Protocol. The upstream version reads
  `named_set_of_files` / `target_completed` events off
  `ctx.bazel.build(build_events = True).build_events()`, but
  `bazel.build.Build` no longer exposes `build_events` (as of Aspect CLI
  v2026.31.12 it carries only `wait`, `try_wait`, `execution_logs` and
  `workspace_events`), so that stream is simply not reachable from a
  task any more. cquery answers the only question we asked BES: which
  file in the default output group is the executable.
"""

def _determine_entrypoint(state, target):
    """First file in `target`'s default output group, or None.

    Runs under the same flags as the preceding build so the answer comes
    from the same configuration — a config-affecting flag on one and not
    the other would resolve a path in a different `bazel-out` tree.

    Paths come back workspace-relative (`bazel-out/<config>/bin/...`),
    which `_command` turns absolute against the caller's cwd; that
    resolves through the `bazel-out` convenience symlink at the
    workspace root.
    """
    ctx = state.ctx
    result = ctx.std.process.command("bazel") \
        .args([
            "cquery",
            "--output=files",
            "--ui_event_filters=-info",
            "--noshow_progress",
        ] + state.flags + [target]) \
        .stdout("piped") \
        .stderr("piped") \
        .spawn() \
        .wait_with_output()
    if result.status.code != 0:
        ctx.std.io.stderr.write(result.stderr)
        return None
    for line in result.stdout.splitlines():
        candidate = line.strip()
        if candidate:
            return candidate
    return None

def _command(ctx, entrypoint, args, env = {}):
    """Build the `std.process.Command` for `entrypoint` without spawning
    it. Sets the runfiles env vars common Bazel runfiles libraries look
    for, plus `BUILD_WORKING_DIRECTORY` and `BUILD_WORKSPACE_DIRECTORY`
    (the same vars `bazel run` sets). `BUILD_WORKSPACE_DIRECTORY` is
    forwarded from this process's env when set (e.g. when aspect itself
    was launched via `bazel run`), and falls back to the current dir
    otherwise — aspect is normally invoked from the workspace root, so
    that matches what `bazel run` would set. Inherits the caller's cwd
    — see module docstring for why we don't chdir into the runfiles tree.
    """
    if not entrypoint.startswith("/"):
        entrypoint = ctx.std.env.current_dir() + "/" + entrypoint
    runfiles = entrypoint + ".runfiles"
    bws = ctx.std.env.var("BUILD_WORKSPACE_DIRECTORY") or ctx.std.env.current_dir()
    proc = ctx.std.process.command(entrypoint) \
        .env("RUNFILES_DIR", runfiles) \
        .env("JAVA_RUNFILES", runfiles) \
        .env("RUNFILES_MANIFEST_FILE", runfiles + "_manifest") \
        .env("BUILD_WORKING_DIRECTORY", ctx.std.env.current_dir()) \
        .env("BUILD_WORKSPACE_DIRECTORY", bws)
    for key, value in env.items():
        proc = proc.env(key, value)
    return proc.args(args)

def _spawn(ctx, entrypoint, args, env = {}):
    return _command(ctx, entrypoint, args, env).spawn()

def runnable(ctx, flags = []):
    """`flags` must match the flags the target was built with — see
    `_determine_entrypoint`."""
    state = struct(ctx = ctx, flags = flags)
    return struct(
        determine_entrypoint = lambda target: _determine_entrypoint(state, target),
        command = lambda entrypoint, args, env = {}: _command(ctx, entrypoint, args, env),
        spawn = lambda entrypoint, args, env = {}: _spawn(ctx, entrypoint, args, env),
    )
