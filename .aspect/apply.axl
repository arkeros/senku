"""
Apply one or more Terraform roots via Bazel, in dependency order.

Usage:
  aspect apply                                       # apply all roots, gar → registry → lb
  aspect apply //infra/cloud/gcp/gar:terraform       # apply one root
  aspect apply //x:terraform --refresh=false         # skip the state refresh
  aspect apply //x:terraform --target=module.foo.bar # surgical apply; repeatable

Each root invokes `<target>.apply` via `runnable` (BES + direct
spawn). The registry's image_push targets set `stamp = "force"`, so
they always consume STABLE_MONOREPO_* workspace status keys without
needing `--stamp` on the command line.

Auto-approves Terraform when running non-interactively (`$CI` is set);
locally you'll get the y/n confirmation prompt per root.
"""

load("./stdlib.axl", "build_and_run", "is_ci", "select_nodes")
load("./terraform.axl", "TF_ARGS", "build_tf_args")

def impl(ctx) -> int:
    err = ctx.std.io.stderr

    env = {"TF_AUTO_APPROVE": "1"} if is_ci(ctx) else {}
    tf_args = build_tf_args(ctx)

    nodes = select_nodes(ctx, ctx.args.root)
    if nodes == None:
        err.write("ERROR: could not determine the deploy set\n")
        return 1

    for node in nodes:
        # A root is driven through its `.apply` runnable and takes the
        # terraform flags; any other node is a plain runnable — an image push
        # — that would not understand them.
        if node.is_root:
            result = build_and_run(ctx, node.label + ".apply", args = tf_args, env = env)
        else:
            result = build_and_run(ctx, node.label, env = env)

        if result == None:
            return 1
        if not result.success:
            err.write("ERROR: {} failed (exit {})\n".format(node.label, result.code))
            return result.code
    return 0

apply = task(
    implementation = impl,
    args = {"root": args.positional()} | TF_ARGS,
)
