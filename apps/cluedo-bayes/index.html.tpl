<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <!--
      Zoom is left alone here, unlike the two action games: this is a dense
      table of probabilities that people will want to pinch into, and nothing
      is decided by who taps first.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Cluedo contra un solucionador bayesiano: entropía, bits esperados y un cuaderno que piensa en voz alta." />
    <meta name="theme-color" content="#12100E" />
    <title>Cluedo vs. Bayes</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background-color: #12100e;
      }
    </style>
    {{HEAD}}
  </head>
  <body>
    <div id="root">{{APP}}</div>
    {{SCRIPTS}}
  </body>
</html>
